# Copy to .env.local and fill in. Everything here is gitignored.

# --- Client (these end up in the browser bundle; anon key is public by design) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Optional integrations (leave empty to hide the feature) ---
# Self-hosted FormBee instance (POST /formbee/email-only). Contact form goes here.
VITE_FORMBEE_ENDPOINT=
# Voice/call assistant backend (see voice-agent/). "Call me" button goes here.
VITE_CALL_CENTER_URL=

# --- Server only (scripts/local-api.mjs, api/ handlers on your Node host) ---
# Groq API keys - https://console.groq.com/keys
GROQ_LLM_API_KEY=
GROQ_STT_API_KEY=
# Hugging Face token (TTS model access) - https://huggingface.co/settings/tokens
HF_TOKEN=
# Needed only by api/messages.js (inserting contact submissions)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: email forwarding via Resend if you keep using api/messages.js
RESEND_API_KEY=

# --- FormBee instance env (see formbee/README.md) ---
# EMAIL_TO=junaid.alani.1@gmail.com
# EMAIL_PROVIDER=smtp.gmail.com
# EMAIL_USER=junaid.alani.1@gmail.com
# EMAIL_PASSWORD=your-gmail-app-password
